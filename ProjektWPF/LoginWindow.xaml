<Window x:Class="ProjektWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjektWPF"
        mc:Ignorable="d"
        Icon="/Assets/favicon.ico"
        Title="Bejelentkezés" Height="350" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#2C2F33"
        KeyDown="Window_KeyDown">
    <Grid>
        <Border CornerRadius="10" Background="#3CB371" Padding="20" Margin="20" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Bejelentkezés" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>

                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <TextBlock Text="Felhasználónév" Foreground="#FFFFFF"/>
                    <TextBox x:Name="UsernameBox" Height="30" BorderBrush="#228B22" BorderThickness="1" Background="#98FB98"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="Jelszó" Foreground="#FFFFFF"/>
                    <Grid>
                        <PasswordBox x:Name="PasswordBox" Height="30" Width="200" BorderBrush="#228B22" BorderThickness="1" Background="#98FB98"/>
                        <TextBox x:Name="PasswordTextBox" Height="30" Width="200" BorderBrush="#228B22" BorderThickness="1" Background="#98FB98" Visibility="Collapsed"/>

                        <Button Content="👁" Width="30" Height="30" HorizontalAlignment="Right" 
        PreviewMouseDown="ShowPassword" 
        PreviewMouseUp="HidePassword"
        MouseLeave="HidePassword"/>
                    </Grid>
                </StackPanel>

                <Button Grid.Row="3" Content="Bejelentkezés" Background="#006400" Foreground="White" Height="40" Click="LoginButton_Click" Margin="0,20,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
