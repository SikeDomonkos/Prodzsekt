<Window x:Class="ProjektWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjektWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="1000" Background="#006400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#004d00" Offset="0.0"/>
                <GradientStop Color="#3CB371" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Button Content="Felhasználók lekérése"
                Click="OpenDataGridWindow_Click"
                Grid.Row="0" 
                Grid.Column="0" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Padding="15,10"
                Background="#3CB371" 
                Foreground="White" 
                FontSize="16" 
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Width="200"
                Height="50"
                BorderBrush="Transparent">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="20" 
                                        Padding="15,10"
                                        BorderBrush="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#3CB371" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Width" Value="200" />
                    <Setter Property="Height" Value="50" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2E8B57" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#228B22" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Content="Szavazások lekérése"
        Click="GetVotes_Click"
        Grid.Row="0" 
        Grid.Column="1" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Center" 
        Padding="15,10"
        Background="#1E90FF" 
        Foreground="White" 
        FontSize="16" 
        FontWeight="Bold"
        BorderThickness="0"
        Cursor="Hand"
        Width="200"
        Height="50"
        BorderBrush="Transparent">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                CornerRadius="20" 
                                Padding="15,10"
                                BorderBrush="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#1E90FF" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Width" Value="200" />
                    <Setter Property="Height" Value="50" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#007FFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#0059B3" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Content="Felhasználók lekérése"
        Click="OpenDataGridWindow_Click"
        Grid.Row="0" 
        Grid.Column="0" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Center" 
        Padding="15,10"
        Background="#3CB371" 
        Foreground="White" 
        FontSize="16" 
        FontWeight="Bold"
        BorderThickness="0"
        Cursor="Hand"
        Width="200"
        Height="50"
        BorderBrush="Transparent">
    <Button.Style>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="20" 
                                Padding="15,10"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#3CB371" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="50" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E8B57" />
                </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#228B22" />
                        </Trigger>
                    </Style.Triggers>
        </Style>
    </Button.Style>
</Button>
        <Button Content="Segítségkérések"
        Click="Segitseg_Click"
        Grid.Row="0" 
        Grid.Column="2" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Center" 
        Padding="15,10"
        Background="Orange" 
        Foreground="White" 
        FontSize="16" 
        FontWeight="Bold"
        BorderThickness="0"
        Cursor="Hand"
        Width="200"
        Height="50"
        BorderBrush="Transparent">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                CornerRadius="20" 
                                Padding="15,10"
                                BorderBrush="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="Orange" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Width" Value="200" />
                    <Setter Property="Height" Value="50" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="Orange" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="Orange" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Border x:Name="Sidebar"
        Grid.Column="3"
        Background="#2E8B57"
        Width="200"
        Height="150"
        HorizontalAlignment="Right"
        VerticalAlignment="Stretch"
        RenderTransformOrigin="1,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SidebarTransform" X="200"/>
            </Border.RenderTransform>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameTextBlock"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="10"/>
                <Button Content="Kijelentkezés"
                Click="Logout_Click"
                Background="Red"
                Foreground="White"
                FontSize="14"
                Padding="10"
                Margin="10"
                Width="150"
                Cursor="Hand"/>
            </StackPanel>
        </Border>
        <Button Content="👤"
                Grid.Column="3"
        Width="40"
        Height="40"
        Background="Transparent"
        Foreground="White"
        FontSize="24"
        FontWeight="Bold"
        BorderThickness="0"
        Cursor="Hand"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="10"
        Click="ToggleSidebar_Click"/>

    </Grid>
</Window>
