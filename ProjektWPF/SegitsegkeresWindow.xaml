<Window x:Class="ProjektWPF.SegitsegkeresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Segítségkérések" Height="450" Width="800" Background="#006400">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#004d00" Offset="0.0"/>
                <GradientStop Color="#3CB371" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="PostsListBox" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5" Background="#2E8B57" MinHeight="100" MinWidth="300">
                            <StackPanel Width="300">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,5" Foreground="White"/>
                                <TextBlock Text="{Binding Location}" FontStyle="Italic" Foreground="LightGray"/>
                                <Button Content="X" HorizontalAlignment="Right" Foreground="White" Background="Red"
                                        Click="DeletePost_Click" Tag="{Binding Id}" Width="30" Height="30" FontWeight="Bold" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</Window>
