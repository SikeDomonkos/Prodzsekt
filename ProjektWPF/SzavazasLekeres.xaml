<Window x:Class="ProjektWPF.SzavazasLekeres"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szavazások lekérése" Height="600" Width="1000">
    <Grid Background="LightBlue">
        <ListBox x:Name="PollsListBox"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Description}" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Margin="5,10,0,0">
                            <TextBlock Text="Igen: " FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Yes}" FontSize="14" Margin="5,0,10,0"/>
                            <TextBlock Text="Nem: " FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="{Binding No}" FontSize="14"/>
                            <!-- X button to delete poll -->
                            <Button Content="X" Width="30" Height="30" Margin="10,0,0,0" Click="DeletePoll_Click" Tag="{Binding Id}" Background="Red" Foreground="White" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
