<Window x:Class="ProjektWPF.SzavazasLekeres"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProjektWPF"
        Title="Szavazások lekérése" Height="600" Width="1000">

    <Window.Resources>
        <local:PollColorConverter x:Key="PollColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#228B22" Offset="0"/>
                <GradientStop Color="#006400" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ListBox x:Name="PollsListBox"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Margin="10"
                 Background="Transparent">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource PollColorConverter}">
                                <Binding Path="Yes"/>
                                <Binding Path="No"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Margin" Value="5"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" CornerRadius="5" Background="#006400" BorderBrush="#004d00" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding Description}" FontSize="14" Foreground="LightGray"/>
                            <TextBlock Text="Közzétette:" FontSize="12" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="Bold" Foreground="LightBlue"/>
                            <StackPanel Orientation="Horizontal" Margin="5,10,0,0">
                                <TextBlock Text="Igen: " FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding Yes}" FontSize="14" Margin="5,0,10,0" Foreground="White"/>
                                <TextBlock Text="Nem: " FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding No}" FontSize="14" Foreground="White"/>
                                <Button Width="30" Height="30" Background="Red" Foreground="White"
                                        Click="DeletePoll_Click" Tag="{Binding Id}">
                                    <TextBlock Text="X"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
