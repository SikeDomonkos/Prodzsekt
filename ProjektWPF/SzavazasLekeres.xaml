<Window x:Class="ProjektWPF.SzavazasLekeres"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProjektWPF"
        Title="Szavazások lekérése" Height="600" Width="1000">

    <Window.Resources>
        <local:PollColorConverter x:Key="PollColorConverter"/>
    </Window.Resources>

    <Grid Background="LightBlue">
        <ListBox x:Name="PollsListBox"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Margin="10">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource PollColorConverter}">
                                <Binding Path="Yes"/>
                                <Binding Path="No"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Margin" Value="5"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Description}" FontSize="14"/>
                            <TextBlock Text="Közzétette:" FontSize="12" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="Bold" Foreground="DarkBlue"/>
                            <StackPanel Orientation="Horizontal" Margin="5,10,0,0">
                                <TextBlock Text="Igen: " FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Yes}" FontSize="14" Margin="5,0,10,0"/>
                                <TextBlock Text="Nem: " FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding No}" FontSize="14"/>
                                <Button Content="X" Width="30" Height="30" Margin="10,0,0,0"
                                        Click="DeletePoll_Click" Tag="{Binding Id}"
                                        Background="Red" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
